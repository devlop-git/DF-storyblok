# Diamonds Factory: copy to apps/diamondsfactory/.env.local and fill in.
# (The brand itself comes from this app's brand/config.js, not from env.)

# Market (story with this `slug` in Storyblok). Defaults to the brand's main market.
NEXT_PUBLIC_MARKET=germany

# Storyblok: Settings > Access Tokens ("Preview" token so draft content works locally)
STORYBLOK_DELIVERY_API_TOKEN=
# Optional: force "draft" or "published" (defaults: draft in dev, published in prod)
STORYBLOK_VERSION=

# Schema migration / backup (npm run migrate:schema:df, npm run backup:df)
# Space ID: Settings > Space. Token: My Account > Personal access tokens.
STORYBLOK_SPACE_ID=
STORYBLOK_MANAGEMENT_TOKEN=
# eu | us | ap | ca | cn (region of your space)
STORYBLOK_REGION=eu
STRAPI_CMS_PATH=D:/diamondfactory-poc/cms/src

# Commerce category API (header navigation). Defaults to this value if unset.
CATEGORY_API_URL=http://localhost:8010/api/category/v1
# Commerce PLP API (product listing pages)
PLP_API_URL=http://localhost:8040/api/plp/v1
# Commerce PDP API (product pages)
PDP_API_URL=http://localhost:8040/api/pdp/v1

# Your Node API
NODE_API_URL=http://localhost:4000
NODE_API_KEY=
