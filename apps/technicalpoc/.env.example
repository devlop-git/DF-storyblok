# Technical POC: copy to apps/technicalpoc/.env.local and fill in.
# (The brand itself comes from this app's brand/config.js, not from env.)

NEXT_PUBLIC_MARKET=uk

# Storyblok "Technical POC" space (EU): Settings > Access Tokens ("Preview" token)
STORYBLOK_DELIVERY_API_TOKEN=
STORYBLOK_VERSION=
# Setup script (npm run setup:algolia-plp): My Account > Personal access tokens
STORYBLOK_SPACE_ID=295839883359322
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_REGION=eu

# Algolia ("My First Application"): PLP products, facets, rules, sorting.
# Search-only key (safe in the browser); never the Write key. See the Algolia POC repo (ALGOLIA_HANDOFF.md).
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=algolia_feed_poc

# Commerce APIs (header navigation, product pages). Defaults to these if unset.
CATEGORY_API_URL=http://localhost:8010/api/category/v1
PDP_API_URL=http://localhost:8040/api/pdp/v2

# Vendure Shop API (cart, coupons, checkout)
VENDURE_SHOP_API_URL=http://localhost:3002/shop-api
# Designs our own PDP can show: their PLP cards open /design/…, others the live site.
NEXT_PUBLIC_PDP_DESIGNS=CLRN349

# off = ignore the PDP API's own promotion (full list price on PDP + cart);
# discounts then only come from coupon codes in the cart. Default: on.
PDP_PROMOTIONS=
