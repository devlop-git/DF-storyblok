# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and any workspace)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (every app) + leftovers from the single-app layout
.next/
/.next-*/
out/

# turborepo cache
.turbo/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real ones stay local (apps/<brand>/.env.local); examples are committed
.env*
!.env.example

# Storyblok backup asset files (the JSON is committed)
/tools/storyblok/backup/*/*/assets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
