{
  "name": "df-storyblok-poc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:df": "turbo run dev --filter=diamondsfactory",
    "dev:ab": "turbo run dev --filter=austenblake",
    "dev:df:http": "turbo run dev:http --filter=diamondsfactory",
    "dev:ab:http": "turbo run dev:http --filter=austenblake",
    "build": "turbo run build",
    "build:df": "turbo run build --filter=diamondsfactory",
    "build:ab": "turbo run build --filter=austenblake",
    "start:df": "npm run start -w diamondsfactory",
    "start:ab": "npm run start -w austenblake",
    "lint": "turbo run lint",
    "migrate:schema:df": "node --env-file=apps/diamondsfactory/.env.local tools/storyblok/migrate-strapi-schema.mjs",
    "migrate:schema:ab": "node --env-file=apps/austenblake/.env.local tools/storyblok/migrate-strapi-schema.mjs",
    "backup:df": "node --env-file=apps/diamondsfactory/.env.local tools/storyblok/backup-storyblok.mjs diamondsfactory",
    "backup:ab": "node --env-file=apps/austenblake/.env.local tools/storyblok/backup-storyblok.mjs austenblake"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "turbo": "^2.11.6"
  }
}
